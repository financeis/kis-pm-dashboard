    {"N25100", "자동차 및 부품", "업종"},
    {"N25200", "내구소비재 및 의류", "업종"},
    {"N25300", "소비자서비스", "업종"},
    {"N25400", "미디어", "업종"},
    {"N25500", "소매", "업종"},
    {"N30000", "필수소비재", "대분류"},
    {"N30100", "음식료소매", "업종"},
    {"N30200", "음식료 및 담배", "업종"},
    {"N30300", "가정 및 개인용품", "업종"},
    {"N35000", "헬스케어", "대분류"},
    {"N35100", "헬스케어 장비 및 서비스", "업종"},
    {"N35200", "제약, 생명공학 및 생명과학", "업종"},
    {"N40000", "금융", "대분류"},
    {"N40100", "은행", "업종"},
    {"N40200", "다각화된 금융", "업종"},
    {"N40300", "보험", "업종"},
    {"N40400", "부동산", "업종"},
    {"N45000", "정보기술", "대분류"},
    {"N45100", "소프트웨어 및 IT서비스", "업종"},
    {"N45200", "기술 하드웨어 및 장비", "업종"},
    {"N45300", "반도체 및 반도체장비", "업종"},
    {"N50000", "통신서비스", "대분류"},
    {"N50100", "통신서비스", "업종"},
    {"N50200", "미디어 및 엔터테인먼트", "업종"},
    {"N55000", "유틸리티", "대분류"},
    {"N55100", "유틸리티", "업종"},
    {"N60000", "부동산", "대분류"},
